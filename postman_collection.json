							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"vishu\",\n    \"email\": \"vishu@example.com\",\n    \"password\": \"yourPassword\",\n    \"role\": \"user\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/identity-service/auth/register",
