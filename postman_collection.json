								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login (Get JWT Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"vishu\",\n    \"password\": \"yourPassword\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/identity-service/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"identity-service",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Validate Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/identity-service/auth/validate?token={{jwt_token}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"identity-service",
								"auth",
								"validate"
							],
							"query": [
								{
									"key": "token",
									"value": "{{jwt_token}}"
								}
							]
						}
					},
					"response": []
				}
			]
